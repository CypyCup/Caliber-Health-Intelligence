# ---------------------------------------------------------------------------
# Caliber Workforce Atlas — environment configuration
# ---------------------------------------------------------------------------
# The Atlas runs with ZERO configuration in "demo" mode: it reads the bundled
# Texas seed from data/seed/texas and captures leads to a local JSON file.
#
# Point it at Supabase (per the CHI business plan §11 stack) by setting the
# variables below and CHI_DATA_SOURCE=supabase.
# ---------------------------------------------------------------------------

# "demo" (default) reads the bundled JSON seed. "supabase" reads Postgres.
CHI_DATA_SOURCE=demo

# --- Supabase (only needed when CHI_DATA_SOURCE=supabase) ------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Never expose the service role key to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Lead capture ----------------------------------------------------------
# "local" (default) appends registrations to data/leads.local.json (gitignored).
# "supabase" writes them to the leads table.
CHI_LEAD_SINK=local
